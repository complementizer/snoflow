# SNOFlow Backend Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables use the SNOFLOW_ prefix.

# =============================================================================
# LLM Backend (required)
# =============================================================================
# Choose one: "openai", "azure-openai", or "anthropic"
SNOFLOW_LLM_BACKEND=openai

# -----------------------------------------------------------------------------
# OpenAI (when LLM_BACKEND=openai)
# -----------------------------------------------------------------------------
SNOFLOW_OPENAI_API_KEY=sk-...
SNOFLOW_OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Azure OpenAI (when LLM_BACKEND=azure-openai)
# -----------------------------------------------------------------------------
# SNOFLOW_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# SNOFLOW_AZURE_OPENAI_API_KEY=...
# SNOFLOW_AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment
# SNOFLOW_AZURE_OPENAI_API_VERSION=2024-02-15-preview

# -----------------------------------------------------------------------------
# Anthropic (when LLM_BACKEND=anthropic)
# -----------------------------------------------------------------------------
# SNOFLOW_ANTHROPIC_API_KEY=sk-ant-...
# SNOFLOW_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Snowstorm Server
# =============================================================================
# Public SNOMED CT browser (default, may have rate limits)
SNOFLOW_SNOWSTORM_URL=https://browser.ihtsdotools.org/snowstorm/snomed-ct

# For local Snowstorm instance:
# SNOFLOW_SNOWSTORM_URL=http://localhost:8080

# Cache Snowstorm responses to a JSON file (portable — copy to another machine)
# SNOFLOW_SNOWSTORM_CACHE_FILE=snowstorm_cache.json

# When true, serve only from cache and never hit the live API (offline mode)
# SNOFLOW_SNOWSTORM_CACHE_ONLY=false

# =============================================================================
# Frontend Snowstorm Cache (browser-side, file-backed)
# =============================================================================
# Cache browser-side Snowstorm API responses to a JSON file (portable).
# Set to a file path to enable. Run online to build up the cache, then set
# CACHE_ONLY=true to work fully offline for repeated inputs.
# VITE_SNOWSTORM_CACHE_FILE=snowstorm_cache.json

# When true, never hit the live API — serve only from the cache file
# VITE_SNOWSTORM_CACHE_ONLY=false

# =============================================================================
# Agentic Search (optional)
# =============================================================================
# When enabled, LLM iteratively searches Snowstorm for better candidates
# if initial results score below threshold. Slower but more accurate.
SNOFLOW_AGENTIC_SEARCH_ENABLED=false
SNOFLOW_AGENTIC_SEARCH_MAX_TURNS=5
SNOFLOW_AGENTIC_SEARCH_SCORE_THRESHOLD=0.85

# =============================================================================
# Server Settings
# =============================================================================
SNOFLOW_HOST=0.0.0.0
SNOFLOW_PORT=8001

# =============================================================================
# LLM Parameters
# =============================================================================
SNOFLOW_LLM_TEMPERATURE=0.1
SNOFLOW_LLM_MAX_TOKENS=4096

# =============================================================================
# Custom Prompts (optional)
# =============================================================================
# Directory containing custom prompt templates (*.md files)
# SNOFLOW_PROMPTS_DIR=/path/to/custom/prompts
